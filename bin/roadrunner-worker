#!/usr/bin/env php
<?php

use LaraGram\Surge\RoadRunner\Factory\ServerRequestFactory;
use LaraGram\Surge\RoadRunner\Factory\StreamFactory;
use LaraGram\Surge\RoadRunner\Factory\UploadedFileFactory;
use LaraGram\Surge\ApplicationFactory;
use LaraGram\Surge\RequestContext;
use LaraGram\Surge\RoadRunner\RoadRunnerClient;
use LaraGram\Surge\Stream;
use LaraGram\Surge\Worker;
use LaraGram\Http\Factory\ServerRequestInterface;
use Spiral\Goridge\Exception\RelayException;
use Spiral\Goridge\Relay;
use Spiral\RoadRunner\Http\PSR7Worker;
use Spiral\RoadRunner\Worker as RoadRunnerWorker;

require __DIR__.'/../fixes/fix-laragram-dd.php';

$basePath = require __DIR__.'/bootstrap.php';

/*
|--------------------------------------------------------------------------
| Start The Surge Worker
|--------------------------------------------------------------------------
|
| Next we will start the Surge worker, which is a long running process to
| handle incoming requests to the application. Surge can intercept the
| incoming requests and proxy them to the LaraGram application for us.
|
*/

$roadRunnerClient = new RoadRunnerClient($psr7Client = new PSR7Worker(
    new RoadRunnerWorker(Relay::create($_ENV['LARAGRAM_SURGE_ROADRUNNER_RELAY'] ?? 'pipes')),
    new ServerRequestFactory,
    new StreamFactory,
    new UploadedFileFactory,
));

$worker = null;

try {
    while ($psr7Request = $psr7Client->waitRequest()) {
        $worker = $worker ?: tap((new Worker(
            new ApplicationFactory($basePath), $roadRunnerClient
        )))->boot();

        if (! $psr7Request instanceof ServerRequestInterface) {
            break;
        }

        [$request, $context] = $roadRunnerClient->marshalRequest(new RequestContext([
            'psr7Request' => $psr7Request,
        ]));

        $worker->handle($request, $context);
    }
} catch (Throwable $e) {
    if (! $e instanceof RelayException) {
        $worker ? report($e) : Stream::shutdown($e);
    }

    exit(1);
} finally {
    if (! is_null($worker)) {
        $worker->terminate();
    }
}
